      font-size: 14px;
      border: 1px solid #a4d4ff;
    }
    .buy-btn {
      background-color: #1f8b57;
    }
    .sell-btn {
      background-color: #b4454c;
    }
    .trade-status {
      font-size: 15px;
      color: #d4e9fb;
      line-height: 1.35;
      padding-top: 2px;
    }
  </style>
</uikit>
