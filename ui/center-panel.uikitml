<uikit>
  <div class="panel">
    <div class="top-row">
      <div class="title-block">
        <text class="eyebrow">TradeSphere AI</text>
        <text id="stock-title" class="header">Apple Inc.</text>
      </div>
      <text id="chart-signal" class="signal-badge">Bullish Session</text>
    </div>

    <div class="hero-card">
      <div class="hero-left">
        <div class="hero-row">
          <text id="price" class="price">$189.45</text>
          <text id="change" class="change">+1.25%</text>
        </div>
        <div class="pill-row">
          <text id="trend-label" class="pill">Bullish Intraday</text>
          <text id="range" class="pill">Range 186.90 - 191.10</text>
          <text id="volume" class="pill">Vol 68.4M</text>
        </div>
      </div>
      <div class="hero-side">
        <text class="hero-side-label">Trade Bias</text>
        <text id="signal" class="hero-side-value">Momentum Breakout</text>
      </div>
    </div>

    <div class="chart-card">
      <div class="chart-title-row">
        <text class="chart-header">Intraday Price Bars</text>
        <text id="chart-high" class="chart-meta">High $191.10</text>
      </div>

      <div class="chart-shell">
        <div class="price-axis">
          <text id="axis-top" class="axis-price">$191.10</text>
          <text id="axis-mid" class="axis-price">$189.00</text>
          <text id="axis-low" class="axis-price">$186.90</text>
        </div>

        <div class="plot-stage">
          <div class="grid-line grid-top"></div>
          <div class="grid-line grid-mid"></div>
          <div class="grid-line grid-low"></div>

          <div class="candle-grid">
            <div class="candle-column">
              <div id="candle-top-0" class="bar-top-gap"></div>
              <div id="body-0" class="price-bar"></div>
              <div id="candle-bottom-0" class="bar-bottom-gap"></div>
              <text id="label-0" class="candle-label">09:30</text>
            </div>
            <div class="candle-column">
              <div id="candle-top-1" class="bar-top-gap"></div>
              <div id="body-1" class="price-bar"></div>
              <div id="candle-bottom-1" class="bar-bottom-gap"></div>
              <text id="label-1" class="candle-label">10:00</text>
            </div>
            <div class="candle-column">
              <div id="candle-top-2" class="bar-top-gap"></div>
              <div id="body-2" class="price-bar"></div>
              <div id="candle-bottom-2" class="bar-bottom-gap"></div>
              <text id="label-2" class="candle-label">10:30</text>
            </div>
            <div class="candle-column">
              <div id="candle-top-3" class="bar-top-gap"></div>
              <div id="body-3" class="price-bar"></div>
              <div id="candle-bottom-3" class="bar-bottom-gap"></div>
              <text id="label-3" class="candle-label">11:00</text>
            </div>
            <div class="candle-column">
              <div id="candle-top-4" class="bar-top-gap"></div>
              <div id="body-4" class="price-bar"></div>
              <div id="candle-bottom-4" class="bar-bottom-gap"></div>
              <text id="label-4" class="candle-label">11:30</text>
            </div>
            <div class="candle-column">
              <div id="candle-top-5" class="bar-top-gap"></div>
              <div id="body-5" class="price-bar"></div>
              <div id="candle-bottom-5" class="bar-bottom-gap"></div>
              <text id="label-5" class="candle-label">12:00</text>
            </div>
            <div class="candle-column">
              <div id="candle-top-6" class="bar-top-gap"></div>
              <div id="body-6" class="price-bar"></div>
              <div id="candle-bottom-6" class="bar-bottom-gap"></div>
              <text id="label-6" class="candle-label">12:30</text>
            </div>
            <div class="candle-column">
              <div id="candle-top-7" class="bar-top-gap"></div>
              <div id="body-7" class="price-bar"></div>
              <div id="candle-bottom-7" class="bar-bottom-gap"></div>
              <text id="label-7" class="candle-label">13:00</text>
            </div>
            <div class="candle-column">
              <div id="candle-top-8" class="bar-top-gap"></div>
              <div id="body-8" class="price-bar"></div>
              <div id="candle-bottom-8" class="bar-bottom-gap"></div>
              <text id="label-8" class="candle-label">13:30</text>
            </div>
            <div class="candle-column">
              <div id="candle-top-9" class="bar-top-gap"></div>
              <div id="body-9" class="price-bar"></div>
              <div id="candle-bottom-9" class="bar-bottom-gap"></div>
              <text id="label-9" class="candle-label">14:00</text>
            </div>
            <div class="candle-column">
              <div id="candle-top-10" class="bar-top-gap"></div>
              <div id="body-10" class="price-bar"></div>
              <div id="candle-bottom-10" class="bar-bottom-gap"></div>
              <text id="label-10" class="candle-label">14:30</text>
            </div>
            <div class="candle-column">
              <div id="candle-top-11" class="bar-top-gap"></div>
              <div id="body-11" class="price-bar"></div>
              <div id="candle-bottom-11" class="bar-bottom-gap"></div>
              <text id="label-11" class="candle-label">15:00</text>
            </div>
          </div>
        </div>
      </div>

      <div class="chart-title-row chart-meta-row">
        <text id="chart-low" class="chart-meta">Low $186.90</text>
        <text id="chart-footnote" class="chart-footnote">Momentum is building through the afternoon session.</text>
      </div>
    </div>

    <div class="trade-row">
      <div class="stats-row">
        <div class="stat-card">
          <text class="stat-label">Signal</text>
