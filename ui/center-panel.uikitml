      font-size: 42px;
      color: #ffffff;
    }
    .signal-badge {
      font-size: 15px;
      color: #082446;
      background-color: #9ad7ff;
      border-radius: 999px;
      padding: 10px 14px;
    }
    .hero-card {
      flex-direction: row;
      justify-content: space-between;
      align-items: center;
      padding: 22px;
      background-color: #0c2f5d;
      border-radius: 24px;
      border: 1px solid #285a93;
      margin-bottom: 18px;
    }
    .hero-left {
      flex-grow: 1;
    }
    .hero-row {
      flex-direction: row;
      align-items: center;
      margin-bottom: 16px;
    }
    .price {
      font-size: 42px;
      color: #ffffff;
      margin-right: 18px;
    }
    .change {
      font-size: 24px;
      color: #63d28f;
    }
    .pill-row {
      flex-direction: row;
    }
    .pill {
      font-size: 15px;
      color: #eaf6ff;
      background-color: #154a8b;
      border-radius: 999px;
      padding: 10px 14px;
      margin-right: 10px;
    }
    .hero-side {
      width: 180px;
      padding: 16px 18px;
      margin-left: 16px;
      background-color: #08254a;
      border-radius: 18px;
      border: 1px solid #214f83;
    }
    .hero-side-label {
      font-size: 14px;
      color: #89cbff;
      margin-bottom: 10px;
    }
    .hero-side-value {
      font-size: 20px;
      color: #ffffff;
    }
    .chart-card {
      flex-grow: 1;
      padding: 22px;
      background-color: #0c2f5d;
      border-radius: 24px;
      border: 1px solid #285a93;
      margin-bottom: 18px;
    }
    .chart-title-row {
      flex-direction: row;
      justify-content: space-between;
      align-items: center;
      margin-bottom: 14px;
    }
    .chart-header {
      font-size: 22px;
      color: #f4fbff;
      margin-right: 16px;
    }
    .chart-meta {
      font-size: 15px;
      color: #d3e9fb;
    }
    .chart-shell {
      flex-direction: row;
      margin-bottom: 14px;
    }
    .price-axis {
      width: 74px;
      height: 190px;
      justify-content: space-between;
      align-items: flex-start;
      padding-top: 6px;
      padding-bottom: 28px;
      margin-right: 12px;
    }
    .axis-price {
      font-size: 14px;
      color: #c1dbf8;
    }
    .plot-stage {
      flex-grow: 1;
      height: 190px;
      padding: 12px 12px 0;
      background-color: #072245;
      border-radius: 20px;
    }
    .grid-line {
      position: absolute;
      left: 10px;
      right: 10px;
      height: 1px;
      background-color: #325e92;
    }
    .grid-top {
      top: 20px;
    }
    .grid-mid {
      top: 78px;
    }
    .grid-low {
      top: 136px;
    }
    .candle-grid {
      flex-direction: row;
      justify-content: space-between;
      align-items: flex-end;
      height: 168px;
    }
    .candle-column {
      width: 24px;
      height: 100%;
      flex-direction: column;
      justify-content: flex-end;
      align-items: center;
      padding-left: 2px;
      padding-right: 2px;
    }
    .bar-top-gap {
      width: 100%;
      height: 20px;
    }
    .price-bar {
      width: 16px;
      height: 56px;
      background-color: #63d28f;
      border-radius: 8px 8px 2px 2px;
      border: 1px solid #d8f7e3;
    }
    .bar-bottom-gap {
      width: 100%;
      height: 10px;
    }
    .candle-label {
      font-size: 11px;
      color: #b6d2ef;
      text-align: center;
      margin-top: 6px;
    }
    .chart-meta-row {
      align-items: flex-start;
      margin-bottom: 0;
    }
    .chart-footnote {
      flex-grow: 1;
      font-size: 16px;
      color: #dcefff;
      line-height: 1.35;
      margin-left: 16px;
    }
    .trade-row {
      flex-direction: row;
      justify-content: space-between;
      align-items: stretch;
    }
    .stats-row {
      width: 61%;
      flex-direction: row;
      justify-content: space-between;
    }
    .stat-card {
      width: 31%;
      padding: 10px;
      background-color: #0a2a56;
      border-radius: 20px;
      border: 1px solid #1f4f84;
    }
    .stat-label {
      font-size: 15px;
      color: #8fcfff;
      margin-bottom: 14px;
      margin-right: 10px;
    }
    .stat-value {
      font-size: 21px;
      color: #ffffff;
      line-height: 1.3;
    }
    .action-card {
      width: 38%;
      padding: 20px;
      background-color: #08254a;
      border-radius: 20px;
      border: 1px solid #1f4f84;
      margin-left: 20px;
    }
    .action-label {
      font-size: 15px;
      color: #8fcfff;
      margin-bottom: 16px;
    }
    .action-buttons {
      flex-direction: row;
      margin-left: 8px;
      gap: 8px;
      margin-bottom: 20px;
    }
    .trade-btn {
      width: 40%;
