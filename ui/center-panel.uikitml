<uikit>
  <div class="panel">
    <text class="eyebrow">TradeSphere AI</text>
    <text id="stock-title" class="header">Apple Inc.</text>

    <div class="hero-row">
      <text id="price" class="price">$189.45</text>
      <text id="change" class="change">+1.25%</text>
    </div>

    <div class="meta-row">
      <text id="trend-label" class="meta-pill">Bullish Intraday</text>
      <text id="range" class="meta-pill">Range 186.90 - 191.10</text>
      <text id="volume" class="meta-pill">Vol 68.4M</text>
    </div>

    <div class="graph-panel">
      <text class="graph-title">Intraday Candles</text>

      <div class="chart-area">
        <div class="chart-bars">
          <div class="chart-column">
            <div id="wick-0" class="wick"></div>
            <div id="body-0" class="body"></div>
          </div>
          <div class="chart-column">
            <div id="wick-1" class="wick"></div>
            <div id="body-1" class="body"></div>
          </div>
          <div class="chart-column">
            <div id="wick-2" class="wick"></div>
            <div id="body-2" class="body"></div>
          </div>
          <div class="chart-column">
            <div id="wick-3" class="wick"></div>
            <div id="body-3" class="body"></div>
          </div>
          <div class="chart-column">
            <div id="wick-4" class="wick"></div>
            <div id="body-4" class="body"></div>
          </div>
          <div class="chart-column">
            <div id="wick-5" class="wick"></div>
            <div id="body-5" class="body"></div>
          </div>
          <div class="chart-column">
            <div id="wick-6" class="wick"></div>
            <div id="body-6" class="body"></div>
          </div>
          <div class="chart-column">
            <div id="wick-7" class="wick"></div>
            <div id="body-7" class="body"></div>
          </div>
        </div>

        <div class="labels-row">
          <text id="label-0" class="axis-label">09:30</text>
          <text id="label-1" class="axis-label">10:00</text>
          <text id="label-2" class="axis-label">10:30</text>
          <text id="label-3" class="axis-label">11:00</text>
          <text id="label-4" class="axis-label">11:30</text>
          <text id="label-5" class="axis-label">12:00</text>
          <text id="label-6" class="axis-label">12:30</text>
          <text id="label-7" class="axis-label">13:00</text>
        </div>
      </div>
    </div>

    <div class="stats-row">
      <div class="stat-card">
        <text class="stat-label">Signal</text>
        <text id="signal" class="stat-value">Momentum Breakout</text>
      </div>
      <div class="stat-card">
        <text class="stat-label">Bias</text>
        <text id="bias" class="stat-value">Accumulation</text>
      </div>
      <div class="stat-card">
        <text class="stat-label">Risk</text>
        <text id="risk" class="stat-value">Medium</text>
      </div>
    </div>
  </div>
  <style>
    .panel {
      flex-direction: column;
      padding: 24px;
      background-color: rgba(5, 24, 56, 0.96);
      width: 100%;
      height: 100%;
      border-radius: 28px;
      border: 1px solid rgba(110, 180, 255, 0.28);
    }
    .eyebrow {
      font-size: 16px;
      color: #7fc8ff;
      margin-bottom: 8px;
    }
    .header {
      font-size: 36px;
      color: white;
      margin-bottom: 12px;
    }
    .hero-row {
      flex-direction: row;
      align-items: center;
      justify-content: flex-start;
      margin-bottom: 12px;
    }
    .price {
      font-size: 40px;
      color: #ffffff;
      margin-right: 16px;
    }
    .change {
      font-size: 24px;
      color: #63d28f;
    }
    .meta-row {
      flex-direction: row;
      justify-content: flex-start;
      margin-bottom: 16px;
    }
    .meta-pill {
      font-size: 15px;
      color: rgba(216, 237, 255, 0.85);
      background-color: rgba(17, 53, 104, 0.88);
      border-radius: 999px;
      padding: 10px 14px;
      margin-right: 10px;
    }
    .graph-panel {
      padding: 18px;
      background-color: rgba(9, 35, 76, 0.9);
      border-radius: 22px;
      border: 1px solid rgba(123, 190, 255, 0.18);
      margin-bottom: 18px;
    }
    .graph-title {
      font-size: 22px;
      color: #f4fbff;
      margin-bottom: 14px;
    }
    .chart-area {
      flex-direction: column;
      padding: 16px 12px 10px;
      background-color: rgba(4, 18, 40, 0.55);
      border-radius: 18px;
    }
    .chart-bars {
      flex-direction: row;
      justify-content: space-between;
      align-items: end;
      height: 180px;
      margin-bottom: 10px;
    }
    .chart-column {
      width: 54px;
      height: 180px;
      flex-direction: column;
      justify-content: end;
      align-items: center;
    }
    .wick {
      width: 6px;
      height: 88px;
      background-color: #63d28f;
      border-radius: 999px;
      margin-bottom: 6px;
    }
    .body {
      width: 24px;
      height: 34px;
      background-color: #63d28f;
      border-radius: 8px;
      margin-bottom: 10px;
    }
    .labels-row {
      flex-direction: row;
      justify-content: space-between;
    }
    .axis-label {
      font-size: 14px;
      color: rgba(216, 237, 255, 0.68);
      width: 54px;
      text-align: center;
    }
    .stats-row {
      flex-direction: row;
      justify-content: space-between;
    }
    .stat-card {
      padding: 14px 16px;
      background-color: rgba(10, 35, 73, 0.9);
      border-radius: 18px;
      border: 1px solid rgba(123, 190, 255, 0.14);
      width: 31%;
    }
    .stat-label {
      font-size: 15px;
      color: rgba(143, 203, 255, 0.82);
      margin-bottom: 8px;
    }
    .stat-value {
      font-size: 22px;
      color: #ffffff;
    }
  </style>
</uikit>
