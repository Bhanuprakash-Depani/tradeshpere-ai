<uikit>
  <div class="panel">
    <text class="header">AI Insights</text>
    <text id="insight-text" class="content">Select a stock to generate insights.</text>
    
    <text class="sub-header">Recommendation</text>
    <text id="rec-text" class="rec">--</text>

    <div class="chat-container">
        <text class="chat-title">TradeSphere Bot</text>
        <button id="voice-btn" class="mic-btn">Microphone / Chat</button>
        <text id="chat-response" class="chat-text">"How is the market today?"</text>
    </div>
  </div>
  <style>
    .panel {
      flex-direction: column;
      padding: 24px;
      background-color: #1a1a1a;
      width: 100%;
      height: 100%;
      border-radius: 16px;
      border: 2px solid #333;
    }
    .header { font-size: 28px; color: #4a90e2; margin-bottom: 12px; }
    .sub-header { font-size: 20px; color: #888; margin-top: 16px; }
    .content { font-size: 18px; color: #eee; margin-bottom: 10px; }
    .rec { font-size: 36px; color: white; font-weight: bold; margin-bottom: 30px; }
    
    .chat-container {
        margin-top: auto;
        background-color: #2a2a2a;
        padding: 16px;
        border-radius: 12px;
    }
    .chat-title { font-size: 16px; color: #666; margin-bottom: 8px; }
    .mic-btn { background-color: #444; padding: 12px; border-radius: 20px; color: white; margin-bottom: 12px; }
    .chat-text { font-size: 16px; color: #aaa; font-style: italic; }
  </style>
</uikit>