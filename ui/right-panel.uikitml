<uikit>
  <div class="panel">
    <text class="eyebrow">Decision Engine</text>
    <text class="header">AI Insights</text>
    <text id="insight-text" class="content">Apple is holding above short-term support while momentum stays constructive.</text>

    <div class="metric-card rec-card">
      <div class="card-row">
        <text class="metric-label">Recommendation</text>
        <text class="card-chip">AI Score</text>
      </div>
      <text id="rec-text" class="rec">BUY</text>
      <text id="confidence" class="confidence">Confidence 78%</text>
    </div>

    <div class="metric-card">
      <text class="metric-label">Why It Matters</text>
      <text id="insight-points" class="point-text">AI demand, improving revenue mix, and steady intraday volume support the move.</text>
    </div>

    <div class="chat-container">
      <text class="chat-title">Voice + Chat Demo</text>
      <button id="voice-btn" class="mic-btn">Ask TradeSphere Bot</button>
      <text id="chat-prompt" class="chat-prompt">Prompt: "Should I buy this breakout?"</text>
      <text id="chat-response" class="chat-text">AI: Momentum is positive, but wait for a clean hold above support.</text>
    </div>
  </div>
  <style>
    .panel {
      flex-direction: column;
      padding: 32px;
      background-color: #061a3d;
      width: 100%;
      height: 100%;
      border-radius: 28px;
      border: 2px solid #295d9c;
    }
    .eyebrow {
      font-size: 16px;
      color: #88d0ff;
      margin-bottom: 10px;
    }
    .header {
      font-size: 34px;
      color: #ffffff;
      margin-bottom: 14px;
    }
    .content {
      font-size: 19px;
      color: #eef7ff;
      margin-bottom: 20px;
      line-height: 1.35;
    }
    .metric-card {
      padding: 20px;
      background-color: #0a2a56;
      border-radius: 20px;
      border: 1px solid #1f4f84;
      margin-bottom: 16px;
    }
    .rec-card {
      background-color: #0c315f;
    }
    .card-row {
      flex-direction: row;
      justify-content: space-between;
      align-items: center;
      margin-bottom: 12px;
    }
    .metric-label {
      font-size: 15px;
      color: #8fcfff;
    }
    .card-chip {
      font-size: 13px;
      color: #082446;
      background-color: #99d6ff;
      border-radius: 999px;
      padding: 8px 12px;
    }
    .rec {
      font-size: 36px;
      color: #ffffff;
      margin-bottom: 10px;
    }
    .confidence {
      font-size: 16px;
      color: #c7def4;
    }
    .point-text {
      font-size: 17px;
      color: #f4fbff;
      line-height: 1.35;
    }
    .chat-container {
      margin-top: auto;
      background-color: #08254a;
      padding: 22px;
      border-radius: 20px;
      border: 1px solid #1f4f84;
    }
    .chat-title {
      font-size: 17px;
      color: #d9eeff;
      margin-bottom: 14px;
    }
    .mic-btn {
      background-color: #1d5ab0;
      padding: 16px;
      border-radius: 18px;
      color: #ffffff;
      margin-bottom: 16px;
      border: 1px solid #b2ddff;
    }
    .chat-prompt {
      font-size: 15px;
      color: #bfd7f3;
      margin-bottom: 12px;
    }
    .chat-text {
      font-size: 16px;
      color: #f4fbff;
      font-style: italic;
      line-height: 1.35;
    }
  </style>
</uikit>
